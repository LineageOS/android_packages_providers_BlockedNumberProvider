package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "BlockedNumberProvider",

    // Only compile source java files in this apk.
    srcs: ["src/**/*.java"],
    static_libs: [
        "android-common",
        "guava",
        "blockednumberprovider_flags_java_lib",
    ],
    jacoco: {
        include_filter: ["com.android.providers.blockednumber.*"],
    },
    platform_apis: true,
    certificate: "shared",
    privileged: true,

}

aconfig_declarations {
    name: "blockednumberprovider_flags",
    package: "com.android.providers.blockednumber.flags",
    container: "system",
    srcs: [
        "blockednumberprovider_flags.aconfig",
    ],
}

java_aconfig_library {
    name: "blockednumberprovider_flags_java_lib",
    aconfig_declarations: "blockednumberprovider_flags",
}
